# Nothing here is required to run the stack — every setting has a sensible default baked into
# backend/config/settings.py, including SECRET_KEY (a dev-only placeholder, clearly marked
# "insecure" the same way Django's own `startproject` scaffolding does it). This file only
# documents the optional overrides. Copy it to `.env` and uncomment what you need; `.env` is
# git-ignored, so anything you put there stays local to you.
#
# CORS_ALLOWED_ORIGINS and ALLOWED_HOSTS are comma-separated lists, not JSON arrays.

# SECRET_KEY=replace-with-your-own-generated-django-secret-key
# DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# API_PREFIX=/api
# DATASET_PATH=/absolute/path/to/your/dataset.json
# LOG_LEVEL=INFO
